{
  "name": "atomic-cannon",
  "version": "3.0.0",
  "description": "Atomic Cannon - Web port of classic turn-based tank combat game",
  "type": "module",
  "packageManager": "pnpm@11.5.2",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc -p tsconfig.app.json && tsc -p tsconfig.node.json",
    "lint": "oxlint --deny-warnings",
    "lint:fix": "oxlint --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"tests/**/*.ts\" \"*.{json,ts}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" \"tests/**/*.ts\" \"*.{json,ts}\"",
    "check": "pnpm format:check && pnpm typecheck && pnpm lint && pnpm test",
    "preview": "vite preview",
    "test": "tsx tests/run.ts"
  },
  "dependencies": {
    "@preact/signals": "^2.9.4",
    "pixi-filters": "^6.1.5",
    "pixi.js": "^8.19.0",
    "preact": "^10.29.7"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.10.6",
    "@types/node": "^26.1.1",
    "oxlint": "^1.74.0",
    "prettier": "^3.9.5",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vite": "^8.1.5"
  }
}
