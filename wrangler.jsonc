{
  // Cloudflare Worker + Durable Object for Atomic Cannon multiplayer.
  // Dev:    pnpm dev:net   (wrangler dev — runs the DO locally; dev == prod)
  // Deploy: pnpm deploy:net (after `pnpm build` produces dist/)
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "atomic-cannon-net",
  "main": "worker/index.ts",
  "compatibility_date": "2025-06-01",

  // Durable Objects: ROOM = one per match (roster/turn state, hibernatable); STATS = ONE global
  // instance ("global") holding the aggregate play counters + per-country tally for the About screen.
  // Both SQLite-backed (free-tier eligible).
  "durable_objects": {
    "bindings": [
      {"name": "ROOM", "class_name": "Room"},
      {"name": "STATS", "class_name": "Stats"},
    ],
  },
  "migrations": [
    {"tag": "v1", "new_sqlite_classes": ["Room"]},
    {"tag": "v2", "new_sqlite_classes": ["Stats"]},
  ],

  // Static client (the Vite build). The Worker handles /api/* and /room/*; every
  // other path falls through to these assets, with SPA fallback to index.html.
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
  },

  // Per-IP limiters (period must be 10 or 60). ROOM_LIMIT gates room creation (/api/new);
  // STATS_LIMIT gates stats uploads (POST /api/stats).
  "ratelimits": [
    {"name": "ROOM_LIMIT", "namespace_id": "1", "simple": {"limit": 30, "period": 60}},
    {"name": "STATS_LIMIT", "namespace_id": "2", "simple": {"limit": 20, "period": 60}},
  ],

  // ── Custom domain (optional) ──────────────────────────────────────────────
  // To serve from your own domain instead of *.workers.dev, add the domain to this
  // Cloudflare account, then uncomment (the zone must be on Cloudflare):
  //   "routes": [{"pattern": "atomic.example.com", "custom_domain": true}],
  //   "workers_dev": false,

  "observability": {"enabled": true},
}
